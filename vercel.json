{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/styles.css",
      "headers": {
        "cache-control": "public, max-age=86400, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/components/$1"
    }
  ]
}